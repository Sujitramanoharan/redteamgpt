# Copy to .env and fill in. Never commit the real .env - it is gitignored.

# --- Environment ---
ENVIRONMENT=development          # set to "production" to enable HSTS and hide /docs
PORT=7860

# --- Authentication ---
# Leave REQUIRE_AUTH=false for a public demo. Set true + real keys for anything else.
REQUIRE_AUTH=false
# Comma-separated. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- CORS ---
# "*" is fine for a public read-only demo; list exact origins in production.
CORS_ORIGINS=*

# --- Abuse controls ---
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_CHARS=20000
MAX_BATCH_SIZE=50

# --- Model ---
MAX_SEQUENCE_LENGTH=256
CHUNK_STRIDE=64
DECISION_THRESHOLD=0.5
# Used only when models/detector is absent (it is gitignored).
MODEL_HUB_ID=

# --- Storage ---
DATABASE_PATH=data/audit.db
AUDIT_RETENTION_DAYS=30

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true

# --- Dataset download (src/data_prep.py only) ---
HF_TOKEN=
