# Copy to .env and fill in. Never commit the real .env - it is gitignored.
# In production (Render) these are set in the dashboard; see RUNBOOK.md.

# --- Environment ---
# "production" turns on HSTS, hides /docs, and refuses to boot with an unsafe
# configuration (SQLite, open CORS, no encryption key, no SMTP, non-https URL).
ENVIRONMENT=development
PORT=7860
# Public URL; links in emails point here. Must be https in production.
# On Render it defaults to the service's onrender.com address.
APP_BASE_URL=http://localhost:5174

# --- Database ---
# Postgres in production. Leave empty locally to use data/app.db (SQLite).
DATABASE_URL=
# Migrations run at startup in development; the container entrypoint runs them
# in production, before the server starts.
AUTO_MIGRATE=true
# Default audit-log retention for new organisations (each org can change it).
AUDIT_RETENTION_DAYS=30

# --- Secrets ---
# Encrypts customers' stored LLM keys. Any random string of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later makes stored keys unreadable (customers must re-enter them).
ENCRYPTION_KEY=

# --- Accounts ---
SIGNUP_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
SESSION_TTL_HOURS=336
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Email (any SMTP provider: Resend, Brevo, SendGrid, Postmark, SES) ---
# Unset locally: verification and reset links are written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RedTeamGPT <no-reply@yourdomain.com>
SMTP_STARTTLS=true

# --- CORS ---
# Empty is right for most deployments: the dashboard is served from the same
# origin as the API. List origins only for customers calling from browsers.
CORS_ORIGINS=

# --- Abuse controls ---
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_CHARS=20000
MAX_BATCH_SIZE=50
# Share rate-limit state across several instances. Optional.
REDIS_URL=

# --- Detector model ---
# Local directory first; otherwise downloaded from the Hugging Face Hub.
MODEL_DIR=models/detector
MODEL_HUB_ID=
# Pin the exact Hub commit that passed evaluation (see RUNBOOK.md).
MODEL_HUB_REVISION=
# Read token for a private model repo, and for gated training datasets.
HF_TOKEN=
# torch, or onnx after `python src/export_onnx.py` shows verdict parity.
INFERENCE_BACKEND=torch
MAX_SEQUENCE_LENGTH=256
CHUNK_STRIDE=64
DECISION_THRESHOLD=0.5

# --- Assistant tab ---
# Answers with YOUR provider key, so each organisation gets a daily allowance.
#   gemini -> https://aistudio.google.com/apikey   groq -> https://console.groq.com/keys
#   openai | anthropic | none (firewall only)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_HISTORY_TURNS=6
DEFAULT_CHAT_DAILY_CAP=50
SCAN_OUTPUT=true

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
# Required to read /metrics in production: "Authorization: Bearer <token>".
METRICS_TOKEN=
# Optional error reporting. Prompts and emails are never sent.
SENTRY_DSN=

# --- Performance ---
# Intra-op threads per inference. 0 = half the cores. Set to 1 under sustained
# concurrent load (measured: 11.5 -> 13.4 req/s on 8 cores).
TORCH_THREADS=0
