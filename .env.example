# Copy to .env and fill in. Never commit the real .env - it is gitignored.

# --- Environment ---
ENVIRONMENT=development          # set to "production" to enable HSTS and hide /docs
PORT=7860

# --- Authentication ---
# Leave REQUIRE_AUTH=false for a public demo. Set true + real keys for anything else.
REQUIRE_AUTH=false
# Comma-separated. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- CORS ---
# "*" is fine for a public read-only demo; list exact origins in production.
CORS_ORIGINS=*

# --- Abuse controls ---
RATE_LIMIT_PER_MINUTE=60
MAX_PROMPT_CHARS=20000
MAX_BATCH_SIZE=50

# --- Model ---
MAX_SEQUENCE_LENGTH=256
CHUNK_STRIDE=64
DECISION_THRESHOLD=0.5
# Used only when models/detector is absent (it is gitignored).
MODEL_HUB_ID=

# --- Assistant LLM ---
# Which provider answers safe questions. Without a key the firewall still runs;
# only answer generation is unavailable.
#   gemini    -> free tier at https://aistudio.google.com/apikey
#   groq      -> free tier at https://console.groq.com/keys
#   openai    -> paid
#   anthropic -> paid
#   none      -> firewall only, no answers
LLM_PROVIDER=none
LLM_API_KEY=
# Prefer floating aliases; Google retires pinned model ids and a stale id 404s.
# gemini: gemini-flash-latest | groq: llama-3.3-70b-versatile
LLM_MODEL=gemini-flash-latest
LLM_HISTORY_TURNS=6
# Scan the model's reply as well as the user's prompt.
SCAN_OUTPUT=true

# --- Storage ---
DATABASE_PATH=data/audit.db
AUDIT_RETENTION_DAYS=30

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true

# --- Dataset download (src/data_prep.py only) ---
HF_TOKEN=

# --- Performance ---
# Intra-op threads per inference. 0 = half the cores (best single-request
# latency). Set to 1 under sustained concurrent load: measured on an 8-core
# CPU it raised throughput 11.5 -> 13.4 req/s and cut median latency at
# concurrency 16 from 1161ms to 403ms, at the cost of a worse tail.
TORCH_THREADS=0
